    <effect id="Warehouse_etc-effect">
      <profile_COMMON>
        <newparam sid="Buildings_png-surface">
          <surface type="2D">
            <init_from>Buildings_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Buildings_png-sampler">
          <sampler2D>
            <source>Buildings_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Buildings_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
